# NixOS's official Nix image, pinned to the verified linux/amd64 manifest digest.
ARG NIX_BASE_IMAGE=ghcr.io/nixos/nix:2.35.4@sha256:05fe61395588e8a11452e9ba4602d4f0eb0ce5db8f7b9fa417c4ec07af79ca42
FROM ${NIX_BASE_IMAGE}

ARG NIX_BASE_IMAGE
LABEL org.opencontainers.image.title="Aether NixOS ISO builder"
LABEL org.aether.builder="nixos"
LABEL org.aether.nix-version="2.35.4"
LABEL org.aether.base-image="${NIX_BASE_IMAGE}"
LABEL org.aether.jsonschema-version="4.26.0"

COPY python-env.nix /tmp/aether-python-env.nix
RUN nix --option sandbox true --option sandbox-fallback false \
      --extra-experimental-features nix-command \
      profile install --profile /nix/var/nix/profiles/aether-python \
      --file /tmp/aether-python-env.nix pythonEnv \
    && /nix/var/nix/profiles/aether-python/bin/python3 \
      -c 'from importlib.metadata import version; assert version("jsonschema") == "4.26.0"'
ENV PATH="/nix/var/nix/profiles/aether-python/bin:${PATH}"

WORKDIR /workspace
CMD ["nix", "--version"]
