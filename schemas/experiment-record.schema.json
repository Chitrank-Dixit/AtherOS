{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-linux.example/schemas/experiment-record.schema.json",
  "title": "Aether experiment record",
  "type": "object",
  "required": ["id", "status", "environment", "commands", "expected", "actual", "evidence", "limitations"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
    "environment": {"type": "string"},
    "commands": {"type": "array", "items": {"type": "string"}},
    "expected": {"type": "string"},
    "actual": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
