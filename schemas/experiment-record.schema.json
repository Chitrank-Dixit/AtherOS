{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-linux.example/schemas/experiment-record.schema.json",
  "title": "Aether experiment record",
  "type": "object",
  "required": ["id", "status", "environment", "os_revision", "package_revisions", "commands", "expected", "actual", "evidence", "limitations"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
    "fixture_only": {"type": "boolean", "default": false, "description": "True only for synthetic schema examples; never use as execution evidence."},
    "environment": {"type": "string"},
    "distribution": {"type": "string", "minLength": 1},
    "distribution_revision": {"type": "string", "minLength": 1},
    "builder_environment": {"type": "string", "minLength": 1},
    "iso_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "build_status": {"enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
    "artifact_status": {"enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
    "checksum_status": {"enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
    "package_manifest_status": {"enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
    "archiso_version_status": {"enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
    "boot_status": {"enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
    "evidence_complete": {"type": "boolean"},
    "build_stage": {"type": "string", "minLength": 1},
    "error": {"type": "string", "minLength": 1},
    "arch_base_image": {"type": "string", "minLength": 1},
    "arch_base_image_digest": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "builder_image_digest": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "arch_archive_snapshot": {"type": "string", "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2}$"},
    "package_manifest": {"type": "string", "minLength": 1},
    "artifact_relative_path": {"type": "string", "minLength": 1},
    "boot_milestones": {
      "type": "object",
      "properties": {
        "uefi_firmware_initialized": {"type": "string", "enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
        "bootloader_displayed": {"type": "string", "enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
        "kernel_booted": {"type": "string", "enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
        "live_environment_reached": {"type": "string", "enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
        "shell_available": {"type": "string", "enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]},
        "network_available": {"type": "string", "enum": ["PASSED", "FAILED", "BLOCKED", "NOT TESTED"]}
      },
      "additionalProperties": false
    },
    "uefi_firmware": {"type": "string"},
    "vm_configuration": {
      "type": "object",
      "properties": {
        "hypervisor": {"type": "string"},
        "architecture": {"type": "string"},
        "cpu_count": {"type": "integer", "minimum": 1},
        "memory_mib": {"type": "integer", "minimum": 1},
        "firmware": {"type": "string"}
      },
      "additionalProperties": false
    },
    "logs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "os_revision": {"type": "string", "minLength": 1},
    "package_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "revision"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "commands": {"type": "array", "items": {"type": "string"}},
    "expected": {"type": "string"},
    "actual": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["PASSED", "FAILED"]}}, "required": ["status"]}, "then": {"properties": {"evidence": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"required": ["blockers"], "properties": {"blockers": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "NOT TESTED"}}, "required": ["status"]}, "then": {"required": ["limitations"], "properties": {"limitations": {"minItems": 1}}}}
  ],
  "additionalProperties": false
}
